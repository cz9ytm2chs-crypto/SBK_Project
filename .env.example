# ── Основное ──
NODE_ENV=development
PORT=4000
# Адрес сайта (витрина) и адрес API
APP_URL=http://localhost:5173
API_URL=http://localhost:4000

# ── База данных ──
# Локально без Docker: npm run db:start (порт 5433, логин/пароль silt/silt). Можно указать и свой PostgreSQL
DATABASE_URL=postgresql://silt:silt@localhost:5433/silt
# Для integration-тестов
TEST_DATABASE_URL=postgresql://silt:silt@localhost:5433/silt_test

# ── Redis (необязательно; без него кэш в памяти) ──
# REDIS_URL=redis://localhost:6379

# ── Почта ──
# file — письма сохраняются в apps/api/.mail/*.eml
# smtp — отправка через SMTP (локально Mailpit: localhost:1025, веб-интерфейс http://localhost:8025)
MAIL_TRANSPORT=file
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_USER=
SMTP_PASS=
MAIL_FROM=SILT <hello@silt.store>

# ── Хранилище фото ──
# local — папка apps/api/uploads; s3 — S3-совместимое хранилище (MinIO, Yandex Object Storage, AWS)
STORAGE_DRIVER=local
S3_ENDPOINT=
S3_REGION=us-east-1
S3_BUCKET=silt
S3_ACCESS_KEY=
S3_SECRET_KEY=
S3_PUBLIC_URL=

# ── Оплата ──
# Тестовая оплата. В production не включается никогда.
PAYMENTS_MOCK_ENABLED=true
MOCK_WEBHOOK_SECRET=change-me-local-secret
# Stripe: https://dashboard.stripe.com/test/apikeys
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
# YooKassa: https://yookassa.ru/my/merchant/integration/api-keys
YOOKASSA_SHOP_ID=
YOOKASSA_SECRET_KEY=

# ── Безопасность ──
# Количество прокси перед приложением (nginx = 1). Нужно для правильного IP в rate limit.
# Секрет для подписанных ссылок (доступ гостя к заказу). В production обязателен.
APP_SECRET=change-me-app-secret-min-16-chars
TRUST_PROXY=0
# В production cookies всегда Secure
COOKIE_SECURE=false
SESSION_TTL_DAYS=30

# ── Production ──
# Путь к собранному фронтенду: API отдаст его с SEO-тегами
# WEB_DIST_PATH=../web/dist
LOG_LEVEL=info
